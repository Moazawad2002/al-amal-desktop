# Supabase Configuration for Al Amal Distribution System
# Replace with your actual project URL and public Anon Key from Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Fallback & Demonstration Mode
# Set to 'true' to allow running with rich pre-loaded Egyptian food distribution demo data
# Set to 'false' to enforce strictly live Supabase database connection only
VITE_ENABLE_OFFLINE_DEMO=true
